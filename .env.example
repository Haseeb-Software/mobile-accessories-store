# =========================================
# DATABASE (PostgreSQL via Supabase, Neon, or any provider)
# =========================================
# Pooled connection string used by the app at runtime
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true"
# Direct (non-pooled) connection string, used by Prisma Migrate
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# =========================================
# AUTHENTICATION (NextAuth)
# =========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# The canonical URL of your deployed app (used by NextAuth in production)
NEXTAUTH_URL="http://localhost:3000"

# =========================================
# CLOUDINARY (product image/video storage)
# =========================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =========================================
# SITE
# =========================================
# Used for SEO metadata, sitemap.xml, and robots.txt
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
